# Pin this image after qualification. Never deploy the floating latest tag.
VLLM_IMAGE=vllm/vllm-openai:v0.10.2

# Modele petit et rapide, suffisant pour un premier realtime maison.
VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct
VLLM_SERVED_MODEL_NAME=restaurant-assistant
VLLM_TOOL_CALL_PARSER=hermes

VLLM_MAX_MODEL_LEN=4096
VLLM_MAX_NUM_SEQS=8
VLLM_GPU_MEMORY_UTILIZATION=0.70

# Hote public du Voice Server (FQDN → TLS Let's Encrypt).
# DNS : enregistrement A vers VOICE_IP (Security Group Scaleway : 80 + 443).
VOICE_DOMAIN=voice.mysmartfood.fr
VOICE_IP=51.159.149.110
ACME_EMAIL=ops@example.com
VLLM_API_KEY=<generate-a-long-random-secret>
HF_TOKEN=

# Fastify joignable depuis l'instance GPU (ngrok en local, domaine API en prod).
NODE_BASE_URL=https://api.example.com
NODE_API_KEY=
LLM_FALLBACK_GPT=true
OPENAI_API_KEY=

# Mount this directory from persistent Scaleway Block Storage.
MODEL_CACHE_PATH=/srv/mysmartfood/model-cache
