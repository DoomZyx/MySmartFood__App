# Copier vers .env SUR le VPS MySmartFood (51.255.203.176), jamais sur Mafrashop.

APP_ENV=preprod
APP_DOMAIN=app.api.mysmartfood.fr
SITE_APEX=mysmartfood.fr
SITE_WWW=www.mysmartfood.fr
DASHBOARD_DOMAIN=dashboard.mysmartfood.fr

POSTGRES_DB=mysmartfood
POSTGRES_OWNER_USER=mysmartfood_owner
POSTGRES_OWNER_PASSWORD=

# Role applicatif (sans BYPASSRLS). Genere un mot de passe >= 16 caracteres.
APP_DB_RUNTIME_PASSWORD=

# Host = service Docker "postgres". Jamais 0.0.0.0:5432 sur l'hote.
DATABASE_URL_OWNER=postgres://mysmartfood_owner:CHANGE_OWNER@postgres:5432/mysmartfood
DATABASE_URL=postgres://mysmartfood_app:CHANGE_APP@postgres:5432/mysmartfood

PUBLIC_HOST=https://app.api.mysmartfood.fr
FRONTEND_URL=https://www.mysmartfood.fr
SITE_URL=https://www.mysmartfood.fr
DASHBOARD_URL=https://dashboard.mysmartfood.fr
COOKIE_DOMAIN=.mysmartfood.fr
CORS_ORIGINS=https://www.mysmartfood.fr,https://dashboard.mysmartfood.fr,https://app.api.mysmartfood.fr
PORT=8080

GOOGLE_CALLBACK_URL=https://app.api.mysmartfood.fr/api/auth/google/callback

# Build SPA : appels et OAuth Google toujours vers app.api (pas api.mysmartfood.fr, pas Vercel).
VITE_API_URL=https://app.api.mysmartfood.fr/
VITE_API_BASE_URL=https://app.api.mysmartfood.fr
VITE_WS_URL=
VITE_APP_URL=/app

VOICE_PROVIDER=python
VOICE_HEALTH_URL=https://voice.mysmartfood.fr/health
VOICE_WS_URL=wss://voice.mysmartfood.fr/media-stream
X_API_KEY=

JWT_SECRET=
COOKIE_SECRET=
DOCUMENT_ENCRYPTION_KEY=
ACCOUNT_IDENTIFIER_ENCRYPTION_KEY=

OPENAI_API_KEY=
OPENAI_KEY_ENCRYPTION_SECRET=
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Identifiant d'objet Price Stripe (price_...), jamais un montant.
STRIPE_PRICE_BETA=
STRIPE_AUTOMATIC_TAX=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
