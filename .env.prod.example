# VPS live uniquement (APP_ENV=prod, port 8080).
# La préproduction est un autre répertoire / autre processus (APP_ENV=preprod, port 8081, Stripe TEST).
# Ne pas réutiliser ce fichier ni ces clés live pour preprod.

APP_ENV=prod
NODE_ENV=production

# Cible finale : runtime vocal Python. Utiliser openai_realtime tant qu'il n'est pas validé.
VOICE_PROVIDER=python
VOICE_HEALTH_URL=https://voice.mysmartfood.fr/health
VOICE_WS_URL=wss://voice.mysmartfood.fr/media-stream

PUBLIC_HOST=https://app.api.mysmartfood.fr
FRONTEND_URL=https://www.mysmartfood.fr
SITE_URL=https://www.mysmartfood.fr
DASHBOARD_URL=https://dashboard.mysmartfood.fr
COOKIE_DOMAIN=.mysmartfood.fr
CORS_ORIGINS=https://www.mysmartfood.fr,https://dashboard.mysmartfood.fr,https://app.api.mysmartfood.fr
PORT=8080

GOOGLE_CALLBACK_URL=https://app.api.mysmartfood.fr/api/auth/google/callback

# Stripe LIVE uniquement. Dashboard Stripe (mode Live) → Developers → Webhooks
# Endpoint live : https://app.api.mysmartfood.fr/api/checkout/webhook
# Le webhook preprod (mode Test) est un endpoint distinct, voir .env.preprod.example.
# Events : checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BETA=
STRIPE_PRICE_ECHAUFFEMENT=
STRIPE_PRICE_MISE_EN_PLACE=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PREMIUM=
# true = TVA calculée par Stripe (prix HT). Le produit Stripe doit avoir un tax code.
STRIPE_AUTOMATIC_TAX=true

OPENAI_API_KEY=
OPENAI_KEY_ENCRYPTION_SECRET=
JWT_SECRET=
COOKIE_SECRET=
DATABASE_URL=
DATABASE_URL_OWNER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DOCUMENT_ENCRYPTION_KEY=
ACCOUNT_IDENTIFIER_ENCRYPTION_KEY=
PLATFORM_ADMIN_ACCESS_CODE=
