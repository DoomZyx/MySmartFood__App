# Runtime préprod : autre répertoire / autre processus que le VPS live (APP_ENV=prod, port 8080).
# Stripe TEST uniquement. Ne jamais coller une clé sk_live_ ici.

APP_ENV=preprod
NODE_ENV=production

# Isolation Postgres : base et rôles DISTINCTS de la prod.
# Prod : database mysmartfood, rôles mysmartfood_owner / mysmartfood_app.
# Préprod : database mysmartfood_preprod, rôles ci-dessous.
# Aucun GRANT croisé vers Mafrashop ni vers la base prod.
#
# Ordre (sur le serveur, depuis backend/, avec le .env préprod chargé) :
# 1. Superuser postgres : bash database/create-preprod-db.sh
# 2. APP_ENV=preprod node database/bootstrapRoles.js
# 3. APP_ENV=preprod pnpm db:migrate
#
# bootstrapRoles.js / migrate.js lisent APP_DB_RUNTIME_ROLE via getRuntimeRole()
# (défaut app_runtime si la variable est absente). En préprod il FAUT la poser :
APP_DB_RUNTIME_ROLE=mysmartfood_preprod_app
# Mot de passe LOGIN du rôle applicatif (16 caractères min). Utilisé par bootstrapRoles.
APP_DB_RUNTIME_PASSWORD=

# DATABASE_URL : runtime Fastify = rôle applicatif (sans BYPASSRLS, sans tables owned).
# CHANGE_APP = APP_DB_RUNTIME_PASSWORD = PREPROD_APP_PASSWORD du script create-preprod-db.sh.
DATABASE_URL=postgres://mysmartfood_preprod_app:CHANGE_APP@127.0.0.1:5432/mysmartfood_preprod
# DATABASE_URL_OWNER : migrations uniquement. CHANGE_OWNER = PREPROD_OWNER_PASSWORD.
DATABASE_URL_OWNER=postgres://mysmartfood_preprod_owner:CHANGE_OWNER@127.0.0.1:5432/mysmartfood_preprod
# DATABASE_URL_ADMIN : CREATE ROLE (souvent le superuser). Doit cibler mysmartfood_preprod.
DATABASE_URL_ADMIN=postgres://postgres:CHANGE_ADMIN@127.0.0.1:5432/mysmartfood_preprod

# Passer à python lorsque le voice-server de préproduction est validé.
VOICE_PROVIDER=openai_realtime

PUBLIC_HOST=https://preprod.api.mysmartfood.fr
FRONTEND_URL=https://preprod.mysmartfood.fr
SITE_URL=https://preprod.mysmartfood.fr
DASHBOARD_URL=https://preprod.mysmartfood.fr
# Vide : host-only. Ne pas mettre .mysmartfood.fr (cookies partagés avec la prod).
COOKIE_DOMAIN=
CORS_ORIGINS=https://preprod.mysmartfood.fr,https://preprod.api.mysmartfood.fr
PORT=8081

GOOGLE_CALLBACK_URL=https://preprod.api.mysmartfood.fr/api/auth/google/callback

# Stripe TEST uniquement (pas de clés live).
# Dashboard Stripe (mode Test) → Developers → Webhooks
# Endpoint : https://preprod.api.mysmartfood.fr/api/checkout/webhook
# Events : checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Identifiant d'objet Price Stripe test (price_...), jamais un montant.
STRIPE_PRICE_BETA=
# true = TVA calculée par Stripe (prix HT). Le produit Stripe doit avoir un tax code.
STRIPE_AUTOMATIC_TAX=true

OPENAI_API_KEY=
OPENAI_KEY_ENCRYPTION_SECRET=
JWT_SECRET=
COOKIE_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DOCUMENT_ENCRYPTION_KEY=
ACCOUNT_IDENTIFIER_ENCRYPTION_KEY=
PLATFORM_ADMIN_ACCESS_CODE=
