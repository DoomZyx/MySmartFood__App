# Sélection de l'environnement applicatif.
APP_ENV=dev
NODE_ENV=development

# Développement local : pipeline Fastify vers le voice-server Python.
VOICE_PROVIDER=python

PUBLIC_HOST=https://your-dev-tunnel.example
# Un seul tunnel ngrok suffit : ngrok http 8080
# En local l'API lit l'URL https live via http://127.0.0.1:4040/api/tunnels.
# PUBLIC_HOST sert de fallback si l'inspecteur ngrok n'est pas joignable.
# VOICE_GATEWAY_PUBLIC_HOST n'est utile qu'en prod avec un hôte vocal séparé.
FRONTEND_URL=http://localhost:5174
SITE_URL=http://localhost:5174
DASHBOARD_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5174
PORT=8080

# Secrets à fournir dans .env.dev.local, jamais dans ce fichier.
OPENAI_API_KEY=
OPENAI_KEY_ENCRYPTION_SECRET=
JWT_SECRET=
COOKIE_SECRET=
DATABASE_URL=
DATABASE_URL_OWNER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DOCUMENT_ENCRYPTION_KEY=
ACCOUNT_IDENTIFIER_ENCRYPTION_KEY=
# Stripe TEST uniquement. En local : stripe listen --forward-to localhost:8080/api/checkout/webhook
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Identifiant d'objet Price Stripe test (price_...), jamais un montant.
STRIPE_PRICE_BETA=
PLATFORM_ADMIN_ACCESS_CODE=
PLATFORM_ADMIN_PATH=/bf-admin
