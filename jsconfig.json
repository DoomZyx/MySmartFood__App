{
  "compilerOptions": {
    "checkJs": false,
    "jsx": "react-jsx", // JSX sans import
    "target": "esnext", // navigateurs modernes
    "module": "esnext", // ES6
    "baseUrl": "src",
    "allowJs": true,
    "paths": {
      "@site/*": ["site/*"],
      "@dashboard/*": ["dashboard/*"],
      "@shared/*": ["shared/*"]
    }
  }
}
